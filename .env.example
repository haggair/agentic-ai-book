# ============================================================
# agentic-ai-book — environment variable template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# LLM API Keys
# ------------------------------------------------------------

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default OpenAI model used in notebooks
# OPENAI_MODEL=gpt-4o

# Optional: override the default Anthropic model
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ------------------------------------------------------------
# Ollama (free local LLM — no API key required)
# Run: ollama serve
# Docs: https://ollama.com
# ------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434

# Model to use when LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.1

# Set this to "ollama" to use Ollama instead of OpenAI everywhere
# LLM_PROVIDER=openai

# ------------------------------------------------------------
# Vector Database — Qdrant
# docker compose up -d qdrant  (starts on port 6333)
# ------------------------------------------------------------
QDRANT_URL=http://localhost:6333

# Optional: Qdrant API key (required for Qdrant Cloud)
# QDRANT_API_KEY=

# Collection name for the Advisor RAG pipeline
QDRANT_COLLECTION=medical_literature

# ------------------------------------------------------------
# Cache / State — Redis
# docker compose up -d redis  (starts on port 6379)
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------
# Guardian Angel System (GAS) — Capstone Configuration
# ------------------------------------------------------------

# Simulated patient identifier (used in mock sensor stream)
GAS_PATIENT_ID=patient-001

# Email address to receive caregiver alerts (Caregiver Notifier agent)
GAS_ALERT_EMAIL=caregiver@example.com

# Optional: Twilio credentials for SMS alerts
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1...
# GAS_ALERT_PHONE=+1...

# Glucose thresholds (mg/dL) — override defaults if needed
# GAS_GLUCOSE_LOW=70
# GAS_GLUCOSE_HIGH=180
# GAS_GLUCOSE_CRITICAL_LOW=54
# GAS_GLUCOSE_CRITICAL_HIGH=250

# ------------------------------------------------------------
# LangSmith (optional — for tracing & evaluation)
# https://smith.langchain.com/
# ------------------------------------------------------------
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=agentic-ai-book

# ------------------------------------------------------------
# OpenTelemetry (optional — for production observability)
# ------------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=agentic-ai-book

# ------------------------------------------------------------
# Jupyter (used by docker-compose jupyter service)
# ------------------------------------------------------------
JUPYTER_TOKEN=changeme
